{
  "expo": {
    "name": "KundliKosh",
    "slug": "kundlikosh",
    "owner": "vandanaparik",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "kundlikosh",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0726"
    },
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "app.kundlikosh",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#C8501A"
      },
      "permissions": []
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiBaseUrl": "https://kundlikosh-api-jcvueixr.fly.dev",
      "router": {},
      "eas": {
        "projectId": "3cb4631a-7d1f-4a6d-a151-5f2da3613939"
      }
    }
  }
}
